<Window x:Class="GroupedAudioMixer.DeviceSwitchOsd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        Focusable="False">
    <Border Background="#1A1C1E"
            BorderBrush="#33363A"
            BorderThickness="1"
            CornerRadius="8"
            Padding="18,12"
            x:Name="RootBorder">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="16" ShadowDepth="0"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#128266;" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="SWITCHED TO" FontFamily="Segoe UI" FontSize="10" FontWeight="Bold"
                           Foreground="#9AA0A6" Margin="0,0,0,2"/>
                <TextBlock x:Name="DeviceNameText" Text="Device Name" FontFamily="Segoe UI" FontSize="14"
                           FontWeight="Bold" Foreground="#E0A93E"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
