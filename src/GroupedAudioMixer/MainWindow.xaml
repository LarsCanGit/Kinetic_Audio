<Window x:Class="GroupedAudioMixer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GroupedAudioMixer"
        mc:Ignorable="d"
        Title="Grouped Audio Mixer"
        Background="#1A1A1D"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual">
    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#26262B"/>
        <SolidColorBrush x:Key="StripBrush" Color="#2E2E34"/>
        <SolidColorBrush x:Key="StripBorderBrush" Color="#3A3A42"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#0A0A0C"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#E8A33D"/>
        <SolidColorBrush x:Key="LightTextBrush" Color="#EDEDF0"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8A8A93"/>
        <SolidColorBrush x:Key="ThumbBrush" Color="#3D8EF5"/>
        <SolidColorBrush x:Key="ThumbStrokeBrush" Color="#1F5FBF"/>
        <LinearGradientBrush x:Key="ThumbMetalBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EDEDF1" Offset="0.0"/>
            <GradientStop Color="#C2C2C9" Offset="0.18"/>
            <GradientStop Color="#8C8C94" Offset="0.5"/>
            <GradientStop Color="#5A5A61" Offset="0.82"/>
            <GradientStop Color="#37373C" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ThumbMetalStrokeBrush" Color="#1C1C1F"/>
        <SolidColorBrush x:Key="ThumbHighlightBrush" Color="#FFFFFF" Opacity="0.4"/>
        <SolidColorBrush x:Key="MeterGreenBrush" Color="#4CAF6D"/>
        <SolidColorBrush x:Key="MeterYellowBrush" Color="#E8B23D"/>
        <SolidColorBrush x:Key="MeterRedDimBrush" Color="#4A2A2A"/>
        <SolidColorBrush x:Key="MuteIdleBrush" Color="#3A3A42"/>
        <SolidColorBrush x:Key="MuteActiveBrush" Color="#C0392B"/>
        <SolidColorBrush x:Key="SignalDotBrush" Color="#4CAF6D"/>

        <!-- Transparent repeat button used for the fader track's paging regions. -->
        <Style x:Key="FaderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Brushed-metal fader cap: a silver-to-charcoal gradient body with a sheen highlight and an amber center groove, like a physical mixing console fader. -->
        <Style x:Key="FaderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Rectangle Fill="{StaticResource ThumbMetalBrush}"
                                       Stroke="{StaticResource ThumbMetalStrokeBrush}"
                                       StrokeThickness="1"
                                       RadiusX="3" RadiusY="3"/>
                            <Rectangle Height="4" Margin="3,2,3,0" VerticalAlignment="Top"
                                       Fill="{StaticResource ThumbHighlightBrush}"
                                       RadiusX="2" RadiusY="2"/>
                            <Rectangle Height="2" Margin="4,0" VerticalAlignment="Center"
                                       Fill="{StaticResource AmberBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical fader: a thin black track with a circular thumb, Maximum at the top. -->
        <Style x:Key="VerticalFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="IsDirectionReversed" Value="True"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="1"/>
            <Setter Property="SmallChange" Value="0.01"/>
            <Setter Property="LargeChange" Value="0.05"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="16"
                                    Background="{StaticResource TrackBrush}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderRepeatButtonStyle}" Command="Slider.IncreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderRepeatButtonStyle}" Command="Slider.DecreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FaderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Single "Mute" toggle per channel (replaces the Sonar reference's separate M/S buttons). -->
        <Style x:Key="MuteButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="{StaticResource LightTextBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource MuteIdleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                BorderBrush="{StaticResource StripBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MuteActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Decorative VU-meter segment stack (static, not live; see MainWindow.xaml.cs remarks). -->
        <Style x:Key="MeterSegmentStyle" TargetType="Rectangle">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#202024" Padding="20,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#9612;&#9611;&#9613;" FontFamily="Consolas" Foreground="{StaticResource AmberBrush}"
                               FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="GROUPED AUDIO MIXER" Foreground="{StaticResource LightTextBrush}"
                                   FontFamily="Consolas" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="3-CHANNEL CONSOLE" Foreground="{StaticResource MutedTextBrush}"
                                   FontFamily="Consolas" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SignalDotBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="SIGNAL ACTIVE" Foreground="{StaticResource MutedTextBrush}"
                               FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mixer strips -->
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Master strip -->
                <Border Grid.Column="0" Margin="8,0" Background="{StaticResource StripBrush}"
                        BorderBrush="{StaticResource StripBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="MASTER" Foreground="{StaticResource AmberBrush}"
                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="MAIN OUT" Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="MasterMeter" Grid.Column="0" VerticalAlignment="Stretch"
                                        Orientation="Vertical" Margin="0,0,10,0"/>
                            <Slider x:Name="MasterFader" Grid.Column="1" Height="300" Width="30"
                                    Style="{StaticResource VerticalFaderStyle}"
                                    ValueChanged="MasterFader_ValueChanged"/>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource TrackBrush}" CornerRadius="3"
                                Margin="0,16,0,12" Padding="8,4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="MasterDbText" Text="0.0" Foreground="{StaticResource AmberBrush}"
                                           FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="dB" Foreground="{StaticResource AmberBrush}"
                                           FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="MasterMuteButton" Grid.Row="3" Content="MUTE"
                                      Style="{StaticResource MuteButtonStyle}"
                                      Click="MasterMuteButton_Click"/>
                    </Grid>
                </Border>

                <!-- Group 1 strip -->
                <Border Grid.Column="1" Margin="8,0" Background="{StaticResource StripBrush}"
                        BorderBrush="{StaticResource StripBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="GROUP 1" Foreground="{StaticResource LightTextBrush}"
                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="BUS" Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="Group1Meter" Grid.Column="0" VerticalAlignment="Stretch"
                                        Orientation="Vertical" Margin="0,0,10,0"/>
                            <Slider x:Name="Group1Fader" Grid.Column="1" Height="300" Width="30"
                                    Style="{StaticResource VerticalFaderStyle}"
                                    ValueChanged="Group1Fader_ValueChanged"/>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource TrackBrush}" CornerRadius="3"
                                Margin="0,16,0,12" Padding="8,4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="Group1DbText" Text="-3.0" Foreground="{StaticResource LightTextBrush}"
                                           FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="dB" Foreground="{StaticResource LightTextBrush}"
                                           FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="Group1MuteButton" Grid.Row="3" Content="MUTE"
                                      Style="{StaticResource MuteButtonStyle}"
                                      Click="Group1MuteButton_Click"/>
                    </Grid>
                </Border>

                <!-- Mic strip -->
                <Border Grid.Column="2" Margin="8,0" Background="{StaticResource StripBrush}"
                        BorderBrush="{StaticResource StripBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="MIC" Foreground="{StaticResource LightTextBrush}"
                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="INPUT" Foreground="{StaticResource MutedTextBrush}"
                                       FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="MicMeter" Grid.Column="0" VerticalAlignment="Stretch"
                                        Orientation="Vertical" Margin="0,0,10,0"/>
                            <Slider x:Name="MicFader" Grid.Column="1" Height="300" Width="30"
                                    Style="{StaticResource VerticalFaderStyle}"
                                    ValueChanged="MicFader_ValueChanged"/>
                        </Grid>

                        <Border Grid.Row="2" Background="{StaticResource TrackBrush}" CornerRadius="3"
                                Margin="0,16,0,12" Padding="8,4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="MicDbText" Text="-6.0" Foreground="{StaticResource LightTextBrush}"
                                           FontFamily="Consolas" FontSize="14" HorizontalAlignment="Center"/>
                                <TextBlock Text="dB" Foreground="{StaticResource LightTextBrush}"
                                           FontFamily="Consolas" FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ToggleButton x:Name="MicMuteButton" Grid.Row="3" Content="MUTE"
                                      Style="{StaticResource MuteButtonStyle}"
                                      Click="MicMuteButton_Click"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
