<Window x:Class="KineticAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KineticAudio"
        mc:Ignorable="d"
        Title="Kinetic Audio"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="#0A0B0C">
    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Fonts: Oswald (display/labels) and IBM Plex Mono (numeric readouts) per docs/design spec,
             with system-installed fallbacks since neither ships with Windows by default. -->
        <FontFamily x:Key="DisplayFont">Oswald, Arial Narrow, sans-serif</FontFamily>
        <FontFamily x:Key="MonoFont">IBM Plex Mono, Consolas, Courier New, monospace</FontFamily>

        <!-- Canvas background: radial gradient, per spec. -->
        <RadialGradientBrush x:Key="CanvasBrush" GradientOrigin="0.5,-0.1" Center="0.5,-0.1" RadiusX="0.9" RadiusY="0.9">
            <GradientStop Color="#1B1D20" Offset="0.0"/>
            <GradientStop Color="#0A0B0C" Offset="0.55"/>
            <GradientStop Color="#0A0B0C" Offset="1.0"/>
        </RadialGradientBrush>

        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2C2F34" Offset="0.0"/>
            <GradientStop Color="#1C1E21" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RackBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2A2C30" Offset="0.0"/>
            <GradientStop Color="#1E2023" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MasterStripBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#36393E" Offset="0.0"/>
            <GradientStop Color="#25272B" Offset="1.0"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="StripBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#34373C" Offset="0.0"/>
            <GradientStop Color="#23262A" Offset="1.0"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="StripBorderBrush" Color="#131416"/>
        <SolidColorBrush x:Key="HeaderBorderBrush" Color="#101113"/>
        <SolidColorBrush x:Key="RackBorderBrush" Color="#0E0F10"/>

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#EEF0F2"/>
        <SolidColorBrush x:Key="MasterAccentBrush" Color="#F4C67C"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B7076"/>
        <SolidColorBrush x:Key="TickBrush" Color="#5F6469"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#D99A3F"/>
        <SolidColorBrush x:Key="ReadoutTextBrush" Color="#F0C674"/>
        <SolidColorBrush x:Key="ReadoutBgBrush" Color="#0D0E0F"/>

        <SolidColorBrush x:Key="MeterGreenLitBrush" Color="#4FAE5C"/>
        <SolidColorBrush x:Key="MeterGreenUnlitBrush" Color="#232620"/>
        <SolidColorBrush x:Key="MeterYellowLitBrush" Color="#E0B23F"/>
        <SolidColorBrush x:Key="MeterYellowUnlitBrush" Color="#2B2519"/>
        <SolidColorBrush x:Key="MeterRedLitBrush" Color="#E2483F"/>
        <SolidColorBrush x:Key="MeterRedUnlitBrush" Color="#2C1F1E"/>

        <SolidColorBrush x:Key="MuteIdleBrush" Color="#3A3D42"/>
        <SolidColorBrush x:Key="MuteIdleTextBrush" Color="#C7CBD1"/>
        <SolidColorBrush x:Key="MuteActiveBrush" Color="#C23B32"/>
        <SolidColorBrush x:Key="MuteActiveTextBrush" Color="#1A0E0D"/>

        <LinearGradientBrush x:Key="FaderTrackBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#050506" Offset="0.0"/>
            <GradientStop Color="#1C1D1F" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="FaderHousingBrush" Color="#0F1011"/>

        <!-- Brushed-aluminum fader cap: banded top-to-bottom across the thumb's thickness, with a
             bright reference line at the 50% stop, matching the CSS artifact's rotated linear-gradient. -->
        <LinearGradientBrush x:Key="ThumbMetalBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#808489" Offset="0.0"/>
            <GradientStop Color="#C9CCD0" Offset="0.10"/>
            <GradientStop Color="#F0F1F3" Offset="0.20"/>
            <GradientStop Color="#9A9EA4" Offset="0.35"/>
            <GradientStop Color="#6C6F75" Offset="0.48"/>
            <GradientStop Color="#F7F8F9" Offset="0.50"/>
            <GradientStop Color="#6C6F75" Offset="0.52"/>
            <GradientStop Color="#9A9EA4" Offset="0.65"/>
            <GradientStop Color="#F0F1F3" Offset="0.80"/>
            <GradientStop Color="#C9CCD0" Offset="0.90"/>
            <GradientStop Color="#808489" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="ThumbStrokeBrush" Color="#202225"/>

        <LinearGradientBrush x:Key="CogBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EEF0F2" Offset="0.0"/>
            <GradientStop Color="#C9CCD0" Offset="0.20"/>
            <GradientStop Color="#9A9EA4" Offset="0.42"/>
            <GradientStop Color="#797D83" Offset="0.55"/>
            <GradientStop Color="#A4A8AE" Offset="0.68"/>
            <GradientStop Color="#D3D6D9" Offset="0.86"/>
            <GradientStop Color="#EEF0F2" Offset="1.0"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CogBorderBrush" Color="#17181A"/>
        <SolidColorBrush x:Key="CogGlyphBrush" Color="#2A2C30"/>

        <RadialGradientBrush x:Key="RivetBrush" GradientOrigin="0.35,0.3" Center="0.35,0.3" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Color="#9A9EA4" Offset="0.0"/>
            <GradientStop Color="#1A1B1D" Offset="0.7"/>
        </RadialGradientBrush>

        <!-- Transparent repeat button used for the fader track's paging regions. -->
        <Style x:Key="FaderRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fader thumb: a short wide cap (~34 x 14) with the brushed-aluminum banding above. -->
        <Style x:Key="FaderThumbStyle" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="{StaticResource ThumbMetalBrush}"
                                   Stroke="{StaticResource ThumbStrokeBrush}"
                                   StrokeThickness="1"
                                   RadiusX="2" RadiusY="2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vertical fader: -60dB to 0dB (FaderScale), bottom stop is silence, top is full volume. -->
        <Style x:Key="VerticalFaderStyle" TargetType="Slider">
            <Setter Property="Orientation" Value="Vertical"/>
            <Setter Property="Minimum" Value="-60"/>
            <Setter Property="Maximum" Value="0"/>
            <Setter Property="SmallChange" Value="0.5"/>
            <Setter Property="LargeChange" Value="6"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="0.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Width="6"
                                    Background="{StaticResource FaderTrackBrush}"
                                    CornerRadius="3"
                                    HorizontalAlignment="Center"/>
                            <Track x:Name="PART_Track" HorizontalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderRepeatButtonStyle}" Command="Slider.IncreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource FaderRepeatButtonStyle}" Command="Slider.DecreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FaderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Single "Mute" toggle per channel (replaces the Sonar reference's separate M/S buttons). -->
        <Style x:Key="MuteButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Foreground" Value="{StaticResource MuteIdleTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource MuteIdleBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                BorderBrush="{StaticResource StripBorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MuteActiveBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MuteActiveTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- VU-meter segment: lit/unlit fill toggled from code-behind based on the fader's percent-of-range. -->
        <Style x:Key="MeterSegmentStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
        </Style>

        <Style x:Key="TickLabelStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{StaticResource TickBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- Small corner rivet, reused on the rack panel and each strip. -->
        <Style x:Key="RivetStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="{StaticResource RivetBrush}"/>
        </Style>

        <!-- Custom title-bar controls, since WindowStyle="None" drops the native ones. -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MuteIdleBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource MuteActiveBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource MuteActiveTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Border Width="1500" Height="930" Background="{StaticResource CanvasBrush}" Padding="50,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Width="1400" Height="64" HorizontalAlignment="Left"
                        Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource HeaderBorderBrush}"
                        BorderThickness="1" CornerRadius="6"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid Margin="20,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#9612;&#9611;&#9613;" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource AmberBrush}"
                                       FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="KINETIC AUDIO" Foreground="{StaticResource PrimaryTextBrush}"
                                       FontFamily="{StaticResource DisplayFont}" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" Height="24"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Settings cog: opens the Settings window. -->
                            <Grid x:Name="SettingsCog" Width="40" Height="40" Margin="0,0,16,0"
                                  Background="Transparent" Cursor="Hand"
                                  PreviewMouseLeftButtonDown="SettingsCog_PreviewMouseLeftButtonDown">
                                <Ellipse Fill="{StaticResource CogBrush}" Stroke="{StaticResource CogBorderBrush}" StrokeThickness="1.5"/>
                                <Path HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Fill="{StaticResource CogGlyphBrush}"
                                      Data="M8,0 L10,0 L10.6,2 L12.4,2.8 L14,1.6 L15.4,3 L14.2,4.6 L15,6.4 L17,7 L17,9 L15,9.6 L14.2,11.4 L15.4,13 L14,14.4 L12.4,13.2 L10.6,14 L10,16 L8,16 L7.4,14 L5.6,13.2 L4,14.4 L2.6,13 L3.8,11.4 L3,9.6 L1,9 L1,7 L3,6.4 L3.8,4.6 L2.6,3 L4,1.6 L5.6,2.8 L7.4,2 Z M9,5.5 A3.5,3.5 0 1 0 9,12.5 A3.5,3.5 0 1 0 9,5.5 Z"
                                      Width="18" Height="16" Stretch="Uniform"/>
                            </Grid>
                            <!-- Custom window controls (WindowStyle="None" supplies no native ones). -->
                            <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButtonStyle}"
                                    Click="MinimizeButton_Click" ToolTip="Minimize">
                                <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Width="10" Height="10" Stretch="None"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                            <Button x:Name="CloseButton" Style="{StaticResource CloseButtonStyle}" Margin="4,0,0,0"
                                    Click="CloseButton_Click" ToolTip="Close">
                                <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.5" Width="10" Height="10" Stretch="None"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Rack panel -->
                <Border Grid.Row="2" Width="1400" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Background="{StaticResource RackBrush}" BorderBrush="{StaticResource RackBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="32,40">
                    <ItemsControl ItemsSource="{Binding Strips, RelativeSource={RelativeSource AncestorType=Window}}"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Margin" Value="10,0"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="200" BorderBrush="{StaticResource StripBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="22,20">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource StripBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMasterStrip}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource MasterStripBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="360"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Text="{Binding Title}" Margin="0,0,0,16"
                                                   FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMasterStrip}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource MasterAccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <Grid Grid.Row="1" HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Height="360" Margin="0,0,6,0" Loaded="Ticks_Loaded"/>
                                            <Grid Grid.Column="1" Width="11" Height="360" Margin="0,0,8,0" Loaded="Meter_Loaded"/>
                                            <Border Grid.Column="2" Width="56" Height="360" Background="{StaticResource FaderHousingBrush}" CornerRadius="4">
                                                <Slider Height="352" Width="34"
                                                        Style="{StaticResource VerticalFaderStyle}"
                                                        Value="{Binding FaderValueDb, Mode=TwoWay}"
                                                        ValueChanged="Fader_ValueChanged"/>
                                            </Border>
                                        </Grid>

                                        <Border Grid.Row="2" Background="{StaticResource ReadoutBgBrush}" BorderBrush="{StaticResource FaderTrackBrush}"
                                                BorderThickness="1" CornerRadius="3" MinWidth="60" Margin="0,16,0,12" Padding="8,4">
                                            <TextBlock Text="{Binding PercentText}" Foreground="{StaticResource ReadoutTextBrush}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="14" HorizontalAlignment="Center"/>
                                        </Border>

                                        <ToggleButton Grid.Row="3" Content="MUTE" Width="96"
                                                      Style="{StaticResource MuteButtonStyle}"
                                                      IsChecked="{Binding IsMuted, Mode=TwoWay}"
                                                      Click="MuteButton_Click"/>

                                        <Border Grid.Row="4" Margin="0,14,0,0" MaxHeight="110" MinHeight="40"
                                                Background="{StaticResource ReadoutBgBrush}" BorderBrush="{StaticResource FaderTrackBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="8,6"
                                                Visibility="{Binding ShowSessionCard, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid>
                                                <TextBlock Text="No apps assigned" Foreground="{StaticResource SecondaryTextBrush}"
                                                           FontFamily="{StaticResource DisplayFont}" FontSize="10"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                                                           Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding SessionChips}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource StripBrush}" CornerRadius="3"
                                                                        Margin="0,0,0,4" Padding="6,3">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource PrimaryTextBrush}"
                                                                               FontFamily="{StaticResource DisplayFont}" FontSize="10"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </Border>

                                        <Ellipse Width="5" Height="5" Style="{StaticResource RivetStyle}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,8,0,0"/>
                                        <Ellipse Width="5" Height="5" Style="{StaticResource RivetStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"/>
                                        <Ellipse Width="5" Height="5" Style="{StaticResource RivetStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
                                        <Ellipse Width="5" Height="5" Style="{StaticResource RivetStyle}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>
        </Border>
    </Viewbox>
</Window>
